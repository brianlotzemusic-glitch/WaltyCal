    "thumb1": { "input": "input[type=\"file\"]#ItemDigitalThumb1", "key": "input[name=\"data[ItemDigital][thumb1]\"]", "max_mb": 4 },
    "thumb2": { "input": "input[type=\"file\"]#ItemDigitalThumb2", "key": "input[name=\"data[ItemDigital][thumb2]\"]", "max_mb": 4 },
    "thumb3": { "input": "input[type=\"file\"]#ItemDigitalThumb3", "key": "input[name=\"data[ItemDigital][thumb3]\"]", "max_mb": 4 },
    "thumb4": { "input": "input[type=\"file\"]#ItemDigitalThumb4", "key": "input[name=\"data[ItemDigital][thumb4]\"]", "max_mb": 4 }
  },
  "upload_thumbnails_now": "#ItemGenerateThumbnail2",
